# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# API_KEY: Optional shared secret gating the internal API surface.
API_KEY=""

# Port assignment: Hemp OS runs on 3100, Hemp OS DB on 3200, Hemp Agent on 3300
PORT=3100

# Integration: Other system URLs for cross-system communication
HEMP_OS_DB_URL="http://localhost:3200"
HEMP_AGENT_URL="http://localhost:3300"

# NCBI PubMed API key (optional, increases rate limits from 3/sec to 10/sec)
NCBI_API_KEY=""
