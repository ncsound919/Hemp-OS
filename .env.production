# Hemp OS Production Configuration
# Copy to .env and fill in values

NODE_ENV=production
PORT=3100

# REQUIRED: API key for internal route protection
API_KEY=generate-a-random-64-char-key-here

# LLM API Keys (at least one required for strain data enrichment)
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Python Scientific Microservice
PYTHON_SERVICE_URL=http://localhost:8000

# Storage
DATA_DIR=data

# Security
CORS_ORIGIN=https://your-domain.com
BODY_LIMIT_JSON=10mb

# NCBI (optional, increases PubMed rate limits)
NCBI_API_KEY=
