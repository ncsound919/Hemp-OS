{
  "name": "hemp-os",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Hemp-OS monorepo: deterministic kernel, Hemp-Agent orchestrator, and Hemp-DB knowledge layer as a unified system.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "dev:agent": "npm --workspace @hemp-os/agent run dev",
    "dev:db": "npm --workspace @hemp-os/db run dev",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:agent": "npm --workspace @hemp-os/agent run build",
    "build:db": "npm --workspace @hemp-os/db run build",
    "build:all": "npm run build && npm run build:agent && npm run build:db",
    "start": "node dist/server.cjs",
    "test:kernel": "tsx kernel/test.ts",
    "test:integration": "vitest run",
    "test:integration:watch": "vitest",
    "test:agent": "npm --workspace @hemp-os/agent run lint",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@rdkit/rdkit": "^2025.3.4-1.0.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/pg": "^8.20.0",
    "@vitejs/plugin-react": "^5.0.4",
    "better-sqlite3": "^12.11.1",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "cron-parser": "^5.6.1",
    "csv-parse": "^7.0.1",
    "cytoscape": "^3.34.0",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "duckdb": "^1.4.4",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "firebase": "^12.15.0",
    "firebase-admin": "^14.1.0",
    "googleapis": "^173.0.0",
    "helmet": "^8.2.0",
    "jstat": "^1.9.6",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "node-cron": "^4.5.0",
    "onnxruntime-node": "^1.27.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-hot-toast": "^2.6.0",
    "recharts": "^3.9.1",
    "sharp": "^0.35.3",
    "three": "^0.185.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/three": "^0.185.0",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.4",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.62.1",
    "vite": "^6.2.3",
    "vitest": "^4.1.9"
  }
}
